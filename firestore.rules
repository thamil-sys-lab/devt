rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /certificates/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /courses/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /internship_programs/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /it_services/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /software_tools/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /course_applications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /internship_applications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
    match /service_requests/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'vjysupermacy@gmail.com';
    }
  }
}
